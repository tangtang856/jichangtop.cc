---
import { getCollection } from 'astro:content';
import ArticleLayout from '../../layouts/ArticleLayout.astro';

export async function getStaticPaths() {
  const guideEntries = (await getCollection('guides')).sort((a, b) => a.slug.localeCompare(b.slug));
  return guideEntries.map((entry, index) => {
    const prevEntry = guideEntries[(index - 1 + guideEntries.length) % guideEntries.length];
    const nextEntry = guideEntries[(index + 1) % guideEntries.length];

    const sameTag = guideEntries.filter(e => e.slug !== entry.slug && e.data.tag === entry.data.tag);
    const others = guideEntries.filter(e => e.slug !== entry.slug && e.data.tag !== entry.data.tag);
    const related = [...sameTag, ...others].slice(0, 6).map(e => ({
      title: e.data.title,
      url: `/guides/${e.slug}.html`,
      tag: e.data.tag
    }));

    return {
      params: { slug: entry.slug },
      props: {
        entry,
        prevPost: { title: prevEntry.data.title, url: `/guides/${prevEntry.slug}.html` },
        nextPost: { title: nextEntry.data.title, url: `/guides/${nextEntry.slug}.html` },
        relatedPosts: related
      },
    };
  });
}

const { entry, prevPost, nextPost, relatedPosts } = Astro.props;
const { Content } = await entry.render();

const breadcrumbs = [
  { name: '首页', url: '/' },
  { name: '客户端使用教程', url: '/guides/index.html' },
  { name: entry.data.title, url: `/guides/${entry.slug}.html` }
];
---

<ArticleLayout
  title={entry.data.title}
  description={entry.data.description}
  keywords={entry.data.keywords}
  h1={entry.data.h1}
  tag={entry.data.tag}
  readTime={entry.data.readTime}
  date={entry.data.date}
  author={entry.data.author}
  breadcrumbs={breadcrumbs}
  activeNav="guides"
  prevPost={prevPost}
  nextPost={nextPost}
  relatedPosts={relatedPosts}
  hubUrl="/guides/index.html"
  hubLabel="返回教程中心 (34篇)"
>
  <Content />
</ArticleLayout>
