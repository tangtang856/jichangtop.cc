---
import { getCollection } from 'astro:content';
import ArticleLayout from '../../layouts/ArticleLayout.astro';

export async function getStaticPaths() {
  const blogEntries = (await getCollection('blog')).sort((a, b) => a.slug.localeCompare(b.slug));
  return blogEntries.map((entry, index) => {
    const prevEntry = blogEntries[(index - 1 + blogEntries.length) % blogEntries.length];
    const nextEntry = blogEntries[(index + 1) % blogEntries.length];

    const sameTag = blogEntries.filter(e => e.slug !== entry.slug && e.data.tag === entry.data.tag);
    const others = blogEntries.filter(e => e.slug !== entry.slug && e.data.tag !== entry.data.tag);
    const related = [...sameTag, ...others].slice(0, 6).map(e => ({
      title: e.data.title,
      url: `/blog/${e.slug}.html`,
      tag: e.data.tag
    }));

    return {
      params: { slug: entry.slug },
      props: {
        entry,
        prevPost: { title: prevEntry.data.title, url: `/blog/${prevEntry.slug}.html` },
        nextPost: { title: nextEntry.data.title, url: `/blog/${nextEntry.slug}.html` },
        relatedPosts: related
      },
    };
  });
}

const { entry, prevPost, nextPost, relatedPosts } = Astro.props;
const { Content } = await entry.render();

const breadcrumbs = [
  { name: '首页', url: '/' },
  { name: '科学上网技术博客', url: '/blog/index.html' },
  { name: entry.data.title, url: `/blog/${entry.slug}.html` }
];
---

<ArticleLayout
  title={entry.data.title}
  description={entry.data.description}
  keywords={entry.data.keywords}
  h1={entry.data.h1}
  tag={entry.data.tag}
  readTime={entry.data.readTime}
  date={entry.data.date}
  author={entry.data.author}
  breadcrumbs={breadcrumbs}
  activeNav="blog"
  prevPost={prevPost}
  nextPost={nextPost}
  relatedPosts={relatedPosts}
  hubUrl="/blog/index.html"
  hubLabel="返回全部博客 (106篇)"
>
  <Content />
</ArticleLayout>
