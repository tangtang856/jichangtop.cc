---
import Layout from '../../layouts/Layout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import AirportCard from '../../components/AirportCard.astro';
import { airports, type Airport } from '../../data/airports';

export async function getStaticPaths() {
  const recommendConfigs = [
    {
      type: 'budget',
      title: '2026学生党十元以内平价梯子盘点 · 低门槛月付科学上网节点清单 | 机场Top',
      h1: '2026 学生党平价低预算节点盘点 (月付 ¥4.9 - ¥15 精选)',
      desc: '专为学生党、考研查阅资料与轻度上网人群整理的低门槛月付清单，起步仅需 ¥4.9 至 ¥15/月，单 GB 成本低至几分钱。',
      kw: '平价梯子, 学生党翻墙, 十元以内节点, 低预算月付, 便宜科学上网',
      tag: '平价低预算'
    },
    {
      type: 'premium',
      title: '2026企业级IPLC/IEPL纯专线节点盘点 · 高端稳定跨境办公方案 | 机场Top',
      h1: '2026 企业级 IPLC/IEPL 纯内网专线节点盘点',
      desc: '专为对网络稳定性有严苛要求的跨境贸易、外企办公及电竞游戏玩家量身挑选的高端内网专线服务。',
      kw: '企业专线, IPLC专线, IEPL专线, 高端跨境办公, 物理光纤专线',
      tag: '高端企业级'
    },
    {
      type: 'beginner',
      title: '2026小白零门槛一键订阅方案 · 全中文后台开箱即用指南 | 机场Top',
      h1: '2026 新手小白零门槛一键导入方案 (开箱即用)',
      desc: '精选全中文可视化后台、支持一键导入 Clash/Shadowrocket/Sing-box，并提供全套小白配置图文指导的入门方案。',
      kw: '新手翻墙入门, 小白一键订阅, 开箱即用客户端, 翻墙配置指南',
      tag: '新手极速上手'
    },
    {
      type: 'stable',
      title: '2026高可用抗封锁防失联线路盘点 · 敏感时期全天候连通方案 | 机场Top',
      h1: '2026 高可用抗封锁防失联线路盘点 (全天候稳定)',
      desc: '多机房冗余热备、物理专线传输与动态智能分流，确保在敏感特殊时期依然稳定连通不失联。',
      kw: '抗封锁线路, 防失联备用, 高可用专线, 晚高峰不掉线',
      tag: '高抗封锁稳定'
    },
    {
      type: 'ai',
      title: '2026 ChatGPT/Claude原生住宅IP专线 · 告别AI人机验证与封号风控 | 机场Top',
      h1: '2026 ChatGPT 与 Claude 专用原生住宅 IP 节点精选',
      desc: '配备纯净原生住宅IP与双ISP出口，彻底告别 OpenAI 1020 报错与 Claude 封号风控，保障AI对话畅通无阻。',
      kw: 'ChatGPT专用节点, Claude原生IP, AI解锁线路, 双ISP住宅IP',
      tag: 'AI专属高纯净'
    },
    {
      type: 'streaming',
      title: '2026 Netflix/Disney+ 4K流媒体全解锁清单 · 港日台美全版权库 | 机场Top',
      h1: '2026 Netflix / Disney+ 4K 超清流媒体全解锁方案',
      desc: '专线大带宽传输，全量解锁港区、日区、美区、台区 Netflix、Disney+ 与 YouTube Premium，轻松秒开 4K 60帧。',
      kw: 'Netflix解锁, Disney+ 4K, 流媒体全版权解锁, YouTube 4K线路',
      tag: '4K流媒体解锁'
    }
  ];

  return recommendConfigs.map(config => {
    let matchedAirports = [...airports];
    if (config.type === 'budget') {
      matchedAirports = airports.filter(a => a.startingPrice <= 15).sort((a, b) => a.startingPrice - b.startingPrice);
    } else if (config.type === 'premium') {
      matchedAirports = airports.filter(a => a.plans.some(p => p.lineType.includes('专线')));
    } else if (config.type === 'ai') {
      matchedAirports = airports.filter(a => a.aiSupport && a.aiSupport.length > 0);
    } else if (config.type === 'streaming') {
      matchedAirports = airports.filter(a => a.streamingSupport && a.streamingSupport.length > 0);
    }

    return {
      params: { type: config.type },
      props: { config, matchedAirports },
    };
  });
}

const { config, matchedAirports } = Astro.props;

const breadcrumbs = [
  { name: '首页', url: '/' },
  { name: '专题推荐', url: '/recommend/budget.html' },
  { name: config.h1, url: `/recommend/${config.type}.html` }
];
---

<Layout
  title={config.title}
  description={config.desc}
  keywords={config.kw}
  activeNav="recommend"
>
  <div class="container" style="padding-top:20px;padding-bottom:60px;">
    <Breadcrumbs items={breadcrumbs} />

    <header class="section-header" style="text-align:left;margin-bottom:28px;">
      <div style="display:flex;gap:8px;margin-bottom:10px;">
        <span class="badge badge-primary">{config.tag}</span>
        <span style="font-size:0.85rem;color:#64748b;">精准场景筛选</span>
      </div>
      <h1 style="font-size:2rem;font-weight:800;color:#0f172a;line-height:1.3;margin-bottom:12px;">{config.h1}</h1>
      <p style="font-size:1.02rem;color:#475569;line-height:1.7;max-width:960px;">{config.desc}</p>
    </header>

    <!-- Sub Nav Tabs for recommendations -->
    <div style="display:flex;gap:10px;margin-bottom:32px;flex-wrap:wrap;">
      <a href="/recommend/budget.html" class={`btn ${config.type === 'budget' ? 'btn-primary' : 'btn-outline'} btn-sm`}>低预算平价</a>
      <a href="/recommend/premium.html" class={`btn ${config.type === 'premium' ? 'btn-primary' : 'btn-outline'} btn-sm`}>高端专线</a>
      <a href="/recommend/beginner.html" class={`btn ${config.type === 'beginner' ? 'btn-primary' : 'btn-outline'} btn-sm`}>新手友好</a>
      <a href="/recommend/stable.html" class={`btn ${config.type === 'stable' ? 'btn-primary' : 'btn-outline'} btn-sm`}>稳定防封</a>
      <a href="/recommend/ai.html" class={`btn ${config.type === 'ai' ? 'btn-primary' : 'btn-outline'} btn-sm`}>AI专线解锁</a>
      <a href="/recommend/streaming.html" class={`btn ${config.type === 'streaming' ? 'btn-primary' : 'btn-outline'} btn-sm`}>4K流媒体</a>
    </div>

    <!-- Cards Grid -->
    <div class="airports-grid" style="display:grid;grid-template-columns:repeat(auto-fit, minmax(320px, 1fr));gap:24px;margin-bottom:48px;">
      {matchedAirports.map((airport, index) => (
        <AirportCard airport={airport} rank={index + 1} badge={config.tag} />
      ))}
    </div>

    <!-- Recommendation Guide Advice -->
    <section style="background:#f8fafc;border:1px solid #e2e8f0;border-radius:10px;padding:28px;">
      <h2 style="font-size:1.35rem;font-weight:800;color:#0f172a;margin-top:0;margin-bottom:12px;">
        📌 针对该场景的选购避坑指南
      </h2>
      <p style="font-size:0.92rem;color:#475569;line-height:1.7;margin-bottom:10px;">
        在选购<strong>【{config.h1}】</strong>相关套餐时，建议优先遵循“月付起步、按需续费”的基本策略。
      </p>
      <ul style="font-size:0.9rem;color:#475569;line-height:1.8;padding-left:20px;margin-bottom:0;">
        <li><strong>先测后买：</strong>充分利用月付或低门槛试用套餐，在您自身的本地网络环境中实测晚高峰表现。</li>
        <li><strong>注意倍率：</strong>某些品牌的部分高防节点会设置 2x 或 3x 计费倍率，使用前请在客户端或面板核对消耗。</li>
        <li><strong>合理分流：</strong>使用 Clash 或 Sing-box 客户端时，务必保持规则分流（Rule Mode），国内流量直连，避免白白消耗代理流量。</li>
      </ul>
    </section>
  </div>
</Layout>
