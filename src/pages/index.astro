---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import AirportCard from '../components/AirportCard.astro';
import RankingTable from '../components/RankingTable.astro';
import { airports } from '../data/airports';

const featuredSlugs = ['breezenet', 'muguang', 'feimaoyun', 'wuyou', 'yinxingren', 'quanqiuyun'];
const featuredAirports = featuredSlugs
  .map(slug => airports.find(a => a.slug === slug))
  .filter((a): a is NonNullable<typeof a> => Boolean(a));
const allBlogPosts = await getCollection('blog');
const latestPosts = allBlogPosts.slice(0, 6);
const allGuides = await getCollection('guides');
const latestGuides = allGuides.slice(0, 4);

const pageTitle = '2026专业中文机场推荐与梯子节点测评指南 · 性价比VPN专线排行榜 | 机场Top';
const pageDesc = '机场Top专注2026年真实科学上网梯子与机场节点测评推荐。基于电信联通移动三网晚高峰实测，深度评测14大精选性价比机场与IPLC企业专线，全量支持4K流媒体与ChatGPT解锁。';
const pageKeywords = '机场推荐, 机场节点, 性价比机场, 梯子推荐, vpn, vpn机场, vpn节点, vpn推荐';

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    {
      '@type': 'Question',
      name: '什么是机场？它与传统 VPN 有什么核心区别？',
      acceptedAnswer: {
        '@type': 'Answer',
        text: '“机场”是中文互联网对基于 Shadowsocks、V2Ray、Trojan、VLESS 等前沿加密协议的分布式代理服务商的俗称。与传统臃肿的全局 VPN（如 OpenVPN、WireGuard 容易被防火墙识别干扰）相比，现代机场具有分流智能（国内直连不耗流量、国外加速）、抗封锁能力强、晚高峰专线（IPLC/IEPL）不过防火墙、低延迟低丢包等显著优势。'
      }
    },
    {
      '@type': 'Question',
      name: '2026年选购科学上网机场节点，最关键看哪些指标？',
      acceptedAnswer: {
        '@type': 'Answer',
        text: '优先看四点：1. 线路架构（优先选择 IPLC/IEPL 纯内网专线或优质 BGP 中继，避免公网直连）；2. 晚高峰稳定性（关注 20:00-23:00 丢包率是否低于 1%）；3. 每 GB 折算单价（月付总价除以实际可用流量，警惕高倍率扣费陷阱）；4. 原生住宅 IP 纯净度（确保解锁 Netflix 非自制剧与 OpenAI ChatGPT/Claude）。'
      }
    },
    {
      '@type': 'Question',
      name: '新手刚接触梯子，应该如何购买和配置客户端？',
      acceptedAnswer: {
        '@type': 'Answer',
        text: '新手建议首先选择支持“月付”且单价在 10-20 元左右的高性价比品牌（如微风网络、暮光网络、飞猫云等）。购买后，在机场用户后台复制订阅链接，导入至 Windows（推荐 Clash Verge Rev）、Android（推荐 CMFA / V2RayNG）、iOS（推荐 Shadowrocket 小火箭）或 macOS 客户端中，开启分流代理即可一键上手。'
      }
    },
    {
      '@type': 'Question',
      name: '为什么不推荐使用完全免费的 VPN 或公共机场节点？',
      acceptedAnswer: {
        '@type': 'Answer',
        text: '免费节点通常存在严重的网络拥堵与高丢包率，且服务器运营成本高昂，免费服务往往通过植入恶意广告、嗅探用户明文上网流量、转售访问记录甚至中间人劫持来牟利，存在极高的个人隐私与账号安全泄露风险。'
      }
    }
  ]
};
---

<Layout
  title={pageTitle}
  description={pageDesc}
  keywords={pageKeywords}
  activeNav="home"
  schema={faqSchema}
>
  <!-- Section 2: Hero -->
  <section class="hero-section" style="background:rgba(4, 10, 26, 0.42);backdrop-filter:blur(3px);padding:64px 0 48px;border-bottom:1px solid rgba(255,255,255,0.15);">
    <div class="container" style="text-align:center;max-width:960px;">
      <div style="display:inline-flex;align-items:center;gap:8px;background:rgba(37,99,235,0.85);color:#ffffff;padding:6px 16px;border-radius:20px;font-size:0.85rem;font-weight:700;margin-bottom:20px;border:1px solid rgba(147,197,253,0.4);">
        <span>🔥 2026年3月最新实测数据发布</span>
        <span>·</span>
        <span>拒绝虚假标榜与跑路黑榜</span>
      </div>

      <h1 style="font-size:2.6rem;font-weight:900;color:#ffffff;line-height:1.25;margin:0 0 18px;letter-spacing:-0.5px;text-shadow:0 2px 14px rgba(0,0,0,0.65);">
        2026 专业中文机场推荐与梯子节点测评指南
      </h1>

      <p style="font-size:1.15rem;color:#e2e8f0;line-height:1.7;margin:0 auto 28px;max-width:820px;text-shadow:0 1px 6px rgba(0,0,0,0.6);">
        严选 14 大主流高<strong style="color:#60a5fa;">性价比机场</strong>与 IPLC 企业专线<strong style="color:#60a5fa;">机场节点</strong>，为跨国科研、海外办公、<strong style="color:#60a5fa;">vpn推荐</strong>与 4K 流媒体追剧用户提供客观透明的<strong style="color:#60a5fa;">梯子推荐</strong>决策支持。
      </p>

      <div style="display:flex;gap:14px;justify-content:center;flex-wrap:wrap;margin-bottom:32px;">
        <a href="#ranking" class="btn btn-primary" style="padding:12px 28px;font-size:1.02rem;box-shadow:0 4px 14px rgba(37,99,235,0.4);">查看综合排行榜 ↓</a>
        <a href="/recommend/budget.html" class="btn btn-outline" style="padding:12px 28px;font-size:1.02rem;background:rgba(255,255,255,0.92);color:#0f172a;border-color:#ffffff;">平价低预算专题</a>
        <a href="/compare/index.html" class="btn btn-secondary" style="padding:12px 28px;font-size:1.02rem;background:rgba(255,255,255,0.92);color:#0f172a;">在线横向参数PK</a>
      </div>

      <!-- Trust Badges Bar -->
      <div style="display:flex;justify-content:center;gap:24px;flex-wrap:wrap;font-size:0.88rem;color:#cbd5e1;padding-top:16px;border-top:1px solid rgba(255,255,255,0.18);">
        <span>🛡️ 100% 真实三网晚高峰压测</span>
        <span>⚡ 严打虚标/真实可用每GB折算</span>
        <span>🌐 原生住宅IP/ChatGPT完全绿标</span>
        <span>🔄 每周持续校准资费与可用性</span>
      </div>
    </div>
  </section>

  <!-- Section 3: 快速答案 (Quick Answers) -->
  <section class="quick-answers-section home-section-glass">
    <div class="container">
      <div style="text-align:center;margin-bottom:36px;">
        <h2 style="font-size:1.75rem;font-weight:800;color:#0f172a;margin:0 0 8px;">
          小白极速选购决策：四句话快速避坑
        </h2>
        <p style="color:#64748b;font-size:0.95rem;margin:0;">帮您在 30 秒内明确选购方向，不花一分冤枉钱</p>
      </div>

      <div style="display:grid;grid-template-columns:repeat(auto-fit, minmax(260px, 1fr));gap:20px;">
        <div style="background:#f8fafc;border:1px solid #e2e8f0;border-radius:8px;padding:22px;">
          <div style="font-size:1.1rem;font-weight:700;color:#0f172a;margin-bottom:8px;display:flex;align-items:center;gap:6px;">
            <span>🎯</span> 新手应该如何选择？
          </div>
          <p style="font-size:0.88rem;color:#475569;line-height:1.6;margin:0;">
            切忌直接年付！优先选择支持 <strong>月付（¥10-¥20 档位）</strong> 的大品牌，使用本站客户端教程一键导入，体验满意后再考虑长期订阅。
          </p>
        </div>

        <div style="background:#f8fafc;border:1px solid #e2e8f0;border-radius:8px;padding:22px;">
          <div style="font-size:1.1rem;font-weight:700;color:#0f172a;margin-bottom:8px;display:flex;align-items:center;gap:6px;">
            <span>⚡</span> 哪些核心参数最关键？
          </div>
          <p style="font-size:0.88rem;color:#475569;line-height:1.6;margin:0;">
            看 <strong>线路架构</strong>。优先选 IPLC/IEPL 专线，物理不过防火墙，晚高峰延迟稳定丢包率低于 0.2%，避免公网直连的严重抖动。
          </p>
        </div>

        <div style="background:#f8fafc;border:1px solid #e2e8f0;border-radius:8px;padding:22px;">
          <div style="font-size:1.1rem;font-weight:700;color:#0f172a;margin-bottom:8px;display:flex;align-items:center;gap:6px;">
            <span>💰</span> 如何判断套餐是否划算？
          </div>
          <p style="font-size:0.88rem;color:#475569;line-height:1.6;margin:0;">
            认准 <strong>每GB单价（成本折算）</strong>。优质平价梯子每GB成本一般在 ¥0.03 ~ ¥0.15 之间，警惕低价却带 5x-10x 高倍率缩水流量的套路。
          </p>
        </div>

        <div style="background:#f8fafc;border:1px solid #e2e8f0;border-radius:8px;padding:22px;">
          <div style="font-size:1.1rem;font-weight:700;color:#0f172a;margin-bottom:8px;display:flex;align-items:center;gap:6px;">
            <span>🤖</span> AI 与流媒体有特殊要求吗？
          </div>
          <p style="font-size:0.88rem;color:#475569;line-height:1.6;margin:0;">
            需要 <strong>双ISP/原生住宅IP</strong>。普通数据中心机房 IP 容易触发 OpenAI 403/1020 阻断或 Netflix 锁自制剧，认准本站绿标支持节点。
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Section 4: 精选推荐 (Featured Airport Cards) -->
  <section class="home-section-glass">
    <div class="container">
      <div style="display:flex;justify-content:space-between;align-items:flex-end;margin-bottom:32px;flex-wrap:wrap;gap:16px;">
        <div>
          <span class="badge badge-primary">编辑精选推荐</span>
          <h2 style="font-size:1.75rem;font-weight:800;color:#0f172a;margin:8px 0 0;">
            2026 本月重点推荐梯子品牌
          </h2>
        </div>
        <a href="/recommend/budget.html" style="color:#2563eb;font-weight:700;text-decoration:none;font-size:0.95rem;">
          查看所有推荐专题 →
        </a>
      </div>

      <div class="airports-grid" style="display:grid;grid-template-columns:repeat(auto-fit, minmax(280px, 1fr));gap:24px;">
        {featuredAirports.map((airport, idx) => (
          <AirportCard airport={airport} rank={idx + 1} badge={idx === 0 ? '超高性价比' : airport.slug === 'yinxingren' ? 'IEPL纯专线' : airport.slug === 'quanqiuyun' ? '经典中转优化' : '全天候专线'} />
        ))}
      </div>
    </div>
  </section>

  <!-- Section 5: 综合排行榜 (Comprehensive Ranking Table) -->
  <section id="ranking" class="home-section-glass">
    <div class="container">
      <div style="text-align:center;margin-bottom:36px;">
        <span class="badge badge-primary">实测综合数据</span>
        <h2 style="font-size:1.85rem;font-weight:800;color:#0f172a;margin:8px 0 10px;">
          2026 全网综合机场排行榜 (14大精选品牌)
        </h2>
        <p style="color:#64748b;font-size:0.95rem;max-width:760px;margin:0 auto;">
          本榜单综合晚高峰延迟、丢包率、单GB折算单价、节点覆盖及售后响应等多项硬指标排定。
        </p>
      </div>

      <RankingTable airports={airports} />

      <div style="margin-top:20px;display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:12px;font-size:0.85rem;color:#64748b;">
        <div>数据更新时间：2026年3月 · 测试环境：电信/联通/移动三网千兆</div>
        <div style="display:flex;gap:16px;">
          <a href="/ranking/value.html" style="color:#2563eb;text-decoration:none;">按性价比排序 →</a>
          <a href="/ranking/budget.html" style="color:#2563eb;text-decoration:none;">按预算最低排序 →</a>
          <a href="/ranking/stable.html" style="color:#2563eb;text-decoration:none;">按专线稳定性排序 →</a>
        </div>
      </div>
    </div>
  </section>

  <!-- Section 6: 按需求选择 (6 Category Entry Points) -->
  <section class="home-section-glass">
    <div class="container">
      <div style="text-align:center;margin-bottom:36px;">
        <span class="badge badge-secondary">场景细分</span>
        <h2 style="font-size:1.75rem;font-weight:800;color:#0f172a;margin:8px 0 10px;">
          按需精准选型：六大核心使用场景
        </h2>
      </div>

      <div style="display:grid;grid-template-columns:repeat(auto-fit, minmax(280px, 1fr));gap:20px;">
        <a href="/recommend/budget.html" style="background:#fff;border:1px solid #e2e8f0;border-radius:8px;padding:24px;text-decoration:none;display:block;transition:all 0.2s;" onmouseover="this.style.borderColor='#2563eb';this.style.transform='translateY(-2px)'" onmouseout="this.style.borderColor='#e2e8f0';this.style.transform='none'">
          <div style="font-size:1.5rem;margin-bottom:8px;">💰</div>
          <div style="font-size:1.15rem;font-weight:700;color:#0f172a;margin-bottom:6px;">低预算平价专题</div>
          <p style="font-size:0.88rem;color:#64748b;line-height:1.6;margin:0;">
            月付 ¥10 以内超高性价比，适合学生党、轻度网页检索与论文查阅。
          </p>
        </a>

        <a href="/recommend/premium.html" style="background:#fff;border:1px solid #e2e8f0;border-radius:8px;padding:24px;text-decoration:none;display:block;transition:all 0.2s;" onmouseover="this.style.borderColor='#2563eb';this.style.transform='translateY(-2px)'" onmouseout="this.style.borderColor='#e2e8f0';this.style.transform='none'">
          <div style="font-size:1.5rem;margin-bottom:8px;">🚀</div>
          <div style="font-size:1.15rem;font-weight:700;color:#0f172a;margin-bottom:6px;">高端企业级专线</div>
          <p style="font-size:0.88rem;color:#64748b;line-height:1.6;margin:0;">
            全内网 IPLC/IEPL 纯物理光纤专线，晚高峰 0 丢包，极低抖动体验。
          </p>
        </a>

        <a href="/recommend/beginner.html" style="background:#fff;border:1px solid #e2e8f0;border-radius:8px;padding:24px;text-decoration:none;display:block;transition:all 0.2s;" onmouseover="this.style.borderColor='#2563eb';this.style.transform='translateY(-2px)'" onmouseout="this.style.borderColor='#e2e8f0';this.style.transform='none'">
          <div style="font-size:1.5rem;margin-bottom:8px;">🔰</div>
          <div style="font-size:1.15rem;font-weight:700;color:#0f172a;margin-bottom:6px;">新手小白入门首选</div>
          <p style="font-size:0.88rem;color:#64748b;line-height:1.6;margin:0;">
            支持一键导入主流客户端，配置零门槛，全中文详细后台操作指南。
          </p>
        </a>

        <a href="/recommend/stable.html" style="background:#fff;border:1px solid #e2e8f0;border-radius:8px;padding:24px;text-decoration:none;display:block;transition:all 0.2s;" onmouseover="this.style.borderColor='#2563eb';this.style.transform='translateY(-2px)'" onmouseout="this.style.borderColor='#e2e8f0';this.style.transform='none'">
          <div style="font-size:1.5rem;margin-bottom:8px;">🛡️</div>
          <div style="font-size:1.15rem;font-weight:700;color:#0f172a;margin-bottom:6px;">稳定抗封锁防掉线</div>
          <p style="font-size:0.88rem;color:#64748b;line-height:1.6;margin:0;">
            多地多入口冗余热备，敏感时期不失联，全天候保障商务跨国通信。
          </p>
        </a>

        <a href="/recommend/ai.html" style="background:#fff;border:1px solid #e2e8f0;border-radius:8px;padding:24px;text-decoration:none;display:block;transition:all 0.2s;" onmouseover="this.style.borderColor='#2563eb';this.style.transform='translateY(-2px)'" onmouseout="this.style.borderColor='#e2e8f0';this.style.transform='none'">
          <div style="font-size:1.5rem;margin-bottom:8px;">🤖</div>
          <div style="font-size:1.15rem;font-weight:700;color:#0f172a;margin-bottom:6px;">ChatGPT/Claude专线</div>
          <p style="font-size:0.88rem;color:#64748b;line-height:1.6;margin:0;">
            精选双 ISP 纯净原生住宅 IP，告别 Cloudflare 人机验证与账号风控。
          </p>
        </a>

        <a href="/recommend/streaming.html" style="background:#fff;border:1px solid #e2e8f0;border-radius:8px;padding:24px;text-decoration:none;display:block;transition:all 0.2s;" onmouseover="this.style.borderColor='#2563eb';this.style.transform='translateY(-2px)'" onmouseout="this.style.borderColor='#e2e8f0';this.style.transform='none'">
          <div style="font-size:1.5rem;margin-bottom:8px;">🎬</div>
          <div style="font-size:1.15rem;font-weight:700;color:#0f172a;margin-bottom:6px;">4K流媒体原生解锁</div>
          <p style="font-size:0.88rem;color:#64748b;line-height:1.6;margin:0;">
            全版权解锁港区/日区/美区 Netflix、Disney+ 与 YouTube Premium。
          </p>
        </a>
      </div>
    </div>
  </section>

  <!-- Section 7: 机场横向比较工具入口 Banner -->
  <section class="home-section-glass">
    <div class="container">
      <div style="background:linear-gradient(135deg, #1e3a8a 0%, #2563eb 100%);border-radius:12px;padding:40px;color:#fff;display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:24px;">
        <div style="max-width:680px;">
          <h2 style="font-size:1.8rem;font-weight:800;margin:0 0 10px;color:#fff;">
            还在纠结选哪家？试试机场在线全维度对比工具
          </h2>
          <p style="font-size:1rem;color:#bfdbfe;line-height:1.6;margin:0;">
            支持自由勾选 2 到 4 家品牌，横向对比起步月费、每GB折算、协议支持、AI 解锁及独家优惠码。
          </p>
        </div>
        <a href="/compare/index.html" class="btn btn-secondary" style="background:#fff;color:#1e3a8a;border:none;padding:14px 32px;font-weight:700;font-size:1.05rem;">
          开始在线对比 →
        </a>
      </div>
    </div>
  </section>

  <!-- Section 8: 最新独立深度评测 -->
  <section class="home-section-glass">
    <div class="container">
      <div style="display:flex;justify-content:space-between;align-items:flex-end;margin-bottom:32px;flex-wrap:wrap;gap:16px;">
        <div>
          <span class="badge badge-primary">实机压测</span>
          <h2 style="font-size:1.75rem;font-weight:800;color:#0f172a;margin:8px 0 0;">
            最新独立机场评测报告
          </h2>
        </div>
        <a href="/ranking/overall.html" style="color:#2563eb;font-weight:700;text-decoration:none;font-size:0.95rem;">
          查看全部评测 →
        </a>
      </div>

      <div style="display:grid;grid-template-columns:repeat(auto-fit, minmax(280px, 1fr));gap:20px;">
        {airports.slice(0, 4).map(a => (
          <div style="background:#fff;border:1px solid #e2e8f0;border-radius:8px;padding:22px;display:flex;flex-direction:column;justify-content:space-between;">
            <div>
              <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:8px;">
                <span class="badge badge-secondary" style="font-size:0.75rem;">晚高峰实测 4.8分</span>
                <span style="font-size:0.8rem;color:#64748b;">¥{a.startingPrice}/月起</span>
              </div>
              <h3 style="font-size:1.15rem;font-weight:700;margin:0 0 8px;color:#0f172a;">
                <a href={`/review/${a.slug}.html`} style="color:#0f172a;text-decoration:none;">
                  {a.name} 深度测评
                </a>
              </h3>
              <p style="font-size:0.86rem;color:#64748b;line-height:1.6;margin-bottom:14px;">
                {a.description.slice(0, 75)}...
              </p>
            </div>
            <div style="display:flex;gap:8px;">
              <a href={`/review/${a.slug}.html`} class="btn btn-outline btn-xs" style="flex:1;text-align:center;">测速报告</a>
