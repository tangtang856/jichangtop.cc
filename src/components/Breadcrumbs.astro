---
interface Crumb {
  name: string;
  url?: string;
}

interface Props {
  items: Crumb[];
}

const { items } = Astro.props;
---

<div class="breadcrumbs">
  {items.map((item, index) => (
    <>
      {item.url ? (
        <a href={item.url}>{item.name}</a>
      ) : (
        <span>{item.name}</span>
      )}
      {index < items.length - 1 && <span class="crumb-sep">/</span>}
    </>
  ))}
</div>
