---
import type { Airport } from '../data/airports';

interface Props {
  airport: Airport;
  badge?: string;
  rank?: number;
}

const { airport, badge, rank } = Astro.props;
const starterPlan = airport.plans[0] || { price: airport.startingPrice, trafficGB: 100, unitPricePerGB: 0.1, lineType: '优质专线' };
---

<div class="airport-card">
  <div class="card-top">
    <div style="display:flex;align-items:center;gap:10px;">
      {rank && <span class={`rank-badge rank-${rank}`}>{rank}</span>}
      <h3 class="card-brand-name" style="margin:0;">
        <a href={`/airport/${airport.slug}.html`} style="color:inherit;text-decoration:none;">
          {airport.name}
        </a>
      </h3>
    </div>
    {badge && <span class="badge-status status-tested">{badge}</span>}
  </div>

  <p class="card-desc">{airport.description}</p>

  <div class="card-meta-list">
    <div>
      <span class="meta-label">起步价格</span>
      <span class="meta-val" style="color:var(--primary);">¥{airport.startingPrice} <span style="font-size:0.78rem;color:var(--text-sub);font-weight:400;">/月起</span></span>
    </div>
    <div>
      <span class="meta-label">基准流量</span>
      <span class="meta-val">{starterPlan.trafficGB} GB</span>
    </div>
    <div>
      <span class="meta-label">每GB折算</span>
      <span class="meta-val">¥{starterPlan.unitPricePerGB}</span>
    </div>
    <div>
      <span class="meta-label">线路架构</span>
      <span class="meta-val">{starterPlan.lineType || '优质专线'}</span>
    </div>
  </div>

  {airport.coupon && (
    <div style="background:#fff1f2;border:1px solid #fecdd3;border-radius:6px;padding:8px 12px;margin-bottom:14px;display:flex;justify-content:space-between;align-items:center;">
      <span style="font-size:0.82rem;color:#be123c;">专属优惠券码：<strong style="color:#e11d48;">{airport.coupon}</strong></span>
      <span style="font-size:0.75rem;color:#e11d48;">额外减免</span>
    </div>
  )}

  <div class="card-pros-cons">
    <ul class="pros-list">
      {airport.advantages.slice(0, 3).map((adv) => (
        <li>
          <span>✓</span>
          <div>{adv}</div>
        </li>
      ))}
    </ul>
  </div>

  <div class="card-footer-actions">
    <a href={`/airport/${airport.slug}.html`} class="btn btn-outline btn-sm" style="flex:1;">资费详情</a>
    <a href={`/review/${airport.slug}.html`} class="btn btn-secondary btn-sm" style="flex:1;">测速测评</a>
    <a href={airport.affiliateUrl} target="_blank" rel="noopener noreferrer nofollow" class="btn btn-primary btn-sm" style="flex:1.2;">直达官网 →</a>
  </div>
</div>
