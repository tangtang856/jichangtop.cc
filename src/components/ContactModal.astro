---
---

<div class="search-modal" id="contactModal" role="dialog" aria-modal="true" aria-labelledby="contactModalTitle">
  <div class="search-modal-box" style="max-width:520px;padding:28px;">
    <div style="display:flex;justify-content:space-between;align-items:flex-start;margin-bottom:16px;">
      <div>
        <span class="badge badge-primary" style="margin-bottom:6px;">官方直连通道</span>
        <h3 id="contactModalTitle" style="margin:0;font-size:1.35rem;font-weight:800;color:#0f172a;">
          联络我们 · 商务合作与评测反馈
        </h3>
      </div>
      <button type="button" id="contactCloseBtn" aria-label="关闭联络弹窗" style="background:none;border:none;font-size:1.4rem;color:#64748b;cursor:pointer;padding:2px 6px;line-height:1;">
        ✕
      </button>
    </div>

    <p style="font-size:0.9rem;color:#475569;line-height:1.6;margin:0 0 20px;">
      欢迎品牌测速送测、套餐资费变动勘误、广告商务洽谈及读者技术咨询。编辑部与商务团队将在 24 小时内为您提供专业响应。
    </p>

    <div style="display:flex;flex-direction:column;gap:14px;margin-bottom:20px;">
      <!-- Gmail Card -->
      <div style="background:#f8fafc;border:1px solid #e2e8f0;border-radius:10px;padding:16px;">
        <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:10px;flex-wrap:wrap;gap:8px;">
          <div style="display:flex;align-items:center;gap:8px;">
            <span style="font-size:1.25rem;">📧</span>
            <div>
              <div style="font-weight:700;font-size:0.95rem;color:#0f172a;">官方 Gmail 邮箱</div>
              <div style="font-size:0.85rem;color:#2563eb;font-weight:600;user-select:all;">xintangtang888@gmail.com</div>
            </div>
          </div>
          <button type="button" class="btn btn-outline btn-xs copy-contact-btn" data-copy="xintangtang888@gmail.com">
            复制邮箱
          </button>
        </div>
        <a href="mailto:xintangtang888@gmail.com" class="btn btn-primary btn-sm" style="width:100%;display:block;text-align:center;">
          立即发送 Gmail 邮件 →
        </a>
      </div>

      <!-- Telegram Card -->
      <div style="background:#eff6ff;border:1px solid #bfdbfe;border-radius:10px;padding:16px;">
        <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:10px;flex-wrap:wrap;gap:8px;">
          <div style="display:flex;align-items:center;gap:8px;">
            <span style="font-size:1.25rem;">✈️</span>
            <div>
              <div style="font-weight:700;font-size:0.95rem;color:#1e3a8a;">Telegram 官方客服 (TG)</div>
              <div style="font-size:0.85rem;color:#0284c7;font-weight:700;user-select:all;">@xintangtang</div>
            </div>
          </div>
          <button type="button" class="btn btn-outline btn-xs copy-contact-btn" data-copy="@xintangtang" style="border-color:#93c5fd;color:#1d4ed8;">
            复制 TG 号
          </button>
        </div>
        <a href="https://t.me/xintangtang" target="_blank" rel="noopener noreferrer nofollow" class="btn btn-primary btn-sm" style="width:100%;display:block;text-align:center;background:#0284c7;border-color:#0284c7;">
          打开 Telegram 即时对话 (@xintangtang) →
        </a>
      </div>
    </div>

    <div style="font-size:0.8rem;color:#64748b;border-top:1px solid #f1f5f9;padding-top:12px;display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:8px;">
      <span>响应时间：每日 09:00 - 22:00 (UTC+8)</span>
      <a href="/contact.html" style="color:#2563eb;text-decoration:none;font-weight:600;">查看完整联络页面 →</a>
    </div>
  </div>
</div>
